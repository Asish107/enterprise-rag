# Copy to .env and fill in as needed. All values are optional.

# Enable Claude-generated grounded answers. Without it the service uses a
# deterministic extractive fallback so the pipeline stays fully runnable.
ANTHROPIC_API_KEY=

# Generation
RAG_GENERATION_MODEL=claude-sonnet-5
RAG_MAX_TOKENS=1024

# Retrieval / chunking
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Storage
RAG_DATA_DIR=data
RAG_INDEX_DIR=data/index
