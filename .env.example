# Copy to .env and fill in as needed. All values are optional.

# Generation backend priority: OpenRouter -> Anthropic -> extractive fallback.

# OpenRouter (OpenAI-compatible). Set this to use any OpenRouter-hosted model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Native Anthropic (used only if OPENROUTER_API_KEY is unset).
ANTHROPIC_API_KEY=

# Model slug. For OpenRouter use provider-prefixed slugs, e.g.
#   anthropic/claude-sonnet-4  |  anthropic/claude-3.5-sonnet  |  openai/gpt-4o-mini
# For native Anthropic use a bare model id, e.g. claude-sonnet-4-20250514.
RAG_GENERATION_MODEL=anthropic/claude-sonnet-4
RAG_MAX_TOKENS=1024

# Retrieval / chunking
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Hybrid search (BM25 + vector) is always on. Cross-encoder reranking of the
# fused candidates can be disabled to skip the model download / save latency.
RAG_RERANK=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage
RAG_DATA_DIR=data
RAG_INDEX_DIR=data/index
